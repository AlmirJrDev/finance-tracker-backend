# Copie para .env e preencha
NODE_ENV=development
PORT=3001

# MongoDB Atlas (ou deixe em branco e use `npm run dev:memory`)
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/finance-tracker

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Mesmo Client ID usado no NextAuth do front
GOOGLE_CLIENT_ID=

# Origens permitidas no CORS, separadas por vírgula
FRONTEND_URL=http://localhost:3000

# Login sem Google (nunca ativo em produção)
ALLOW_DEV_LOGIN=false
